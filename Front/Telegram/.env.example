# Токен бота из @BotFather -> /newbot (обязательно)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Username бота (опционально, с @)
TELEGRAM_BOT_USERNAME=@your-bot-username

# Базовый URL API бэкенда. Должен заканчиваться на /api/
# Локально без Docker: http://localhost:5000/api/
# В docker-compose это значение переопределяется на http://backend:5000/api/
API_BASE_URL=http://localhost:5000/api/
