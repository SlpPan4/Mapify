# Токен бота из Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application ID из Discord Developer Portal -> General Information
DISCORD_CLIENT_ID=your-application-id-here

# Базовый URL бэкенда. Локально можно не задавать (по умолчанию http://localhost:5000).
# В docker-compose задаётся как http://backend:5000
API_BASE_URL=http://localhost:5000

# Ключ Tracker Network API (https://tracker.gg/developers) для команды /r6stats
TRN_API_KEY=

# Канал для логов входа/выхода бота с серверов (необязательно — без него логи выключены)
LOG_CHANNEL_ID=

# Кого пинговать в лог-канале (необязательно)
LOG_PING_USER_ID=

# ВАЖНО: боту НЕ нужен ключ админки (ADMIN_API_KEY) и его нельзя сюда добавлять.
# Бот работает только с публичными эндпоинтами: чтение стратегий и подача
# новых на модерацию через /api/submissions/strats. Одобрение — в админ-панели.
