# Токен бота из Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=your-bot-token-here

# Application ID из Discord Developer Portal -> General Information
DISCORD_CLIENT_ID=your-application-id-here

# Базовый URL бэкенда. Локально можно не задавать (по умолчанию http://localhost:5000).
# В docker-compose задаётся как http://backend:5000
API_BASE_URL=http://localhost:5000
