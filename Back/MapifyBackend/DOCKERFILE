# build
FROM mcr.microsoft.com/dotnet/sdk:10.0-preview AS build
WORKDIR /src

COPY MapifyBackend/MapifyBackend.csproj MapifyBackend/
RUN dotnet restore MapifyBackend/MapifyBackend.csproj

COPY MapifyBackend/ MapifyBackend/
RUN dotnet publish MapifyBackend/MapifyBackend.csproj -c Release -o /app/publish --no-restore

# runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-preview AS runtime
WORKDIR /app

COPY --from=build /app/publish .

# Install curl for healthchecks and ensure the non-root user can write the SQLite database
USER root
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /app/data && chown -R app:app /app/data
USER app

EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000

ENTRYPOINT ["dotnet", "MapifyBackend.dll"]
