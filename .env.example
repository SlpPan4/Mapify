# Корневой .env — docker compose автоматически подхватывает его при запуске.
# Ключ админки: им пользуются и бэкенд (AdminApi__Key), и админ-панель (VITE_API_KEY).
# Если .env нет, docker-compose.yaml подставляет dev-значение mapify-dev-admin-key,
# так что для локального запуска этот файл создавать не обязательно.
ADMIN_API_KEY=mapify-dev-admin-key
